# ANIKA-AI Environment Configuration
# Copy this file to .env and fill in your values

# Secret key for session encryption & Flask security
SECRET_KEY=anika-ai-super-secret-key-change-in-production-2026

# Database configuration (defaults to SQLite: instance/anika.db)
DATABASE_URL=sqlite:///anika.db

# Google Gemini API key (Get a free key from: https://aistudio.google.com/app/apikey)
# System includes automatic resilient fallback if key is empty or invalid
GEMINI_API_KEY=

# Optional: OpenAI API key fallback
OPENAI_API_KEY=

# Backend & Server Ports
FLASK_PORT=5000
NODE_PORT=5001
VITE_PORT=5173

# Upload settings
MAX_UPLOAD_SIZE_MB=16
UPLOAD_FOLDER=uploads
